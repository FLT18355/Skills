{
  "ignorePatterns": [
    {
      "pattern": "^(https?://)?localhost",
      "reason": "Local development URLs"
    },
    {
      "pattern": "^#",
      "reason": "Anchor links within the same file"
    },
    {
      "pattern": "^\\.",
      "reason": "Relative file links"
    },
    {
      "pattern": "^\\./",
      "reason": "Relative file links"
    },
    {
      "pattern": "^\\../",
      "reason": "Relative file links"
    }
  ],
  "retryCount": 3,
  "retryDelayMs": 1000,
  "timeoutMs": 10000,
  "aliveStatusCodes": [200, 201, 204, 301, 302, 429],
  "replacementPatterns": [
    {
      "pattern": "/home/flt18355/Daily/projects/Skills",
      "replacement": "https://github.com/FLT18355/Skills"
    }
  ]
}